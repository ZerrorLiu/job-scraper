{
  "title": "Fine-screen batch response",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "job_id",
          "variant",
          "core_fit",
          "daily_work",
          "covered",
          "addable",
          "true_gap",
          "score",
          "rationale"
        ],
        "properties": {
          "job_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "variant": {
            "anyOf": [
              {"type": "string", "minLength": 1, "maxLength": 100},
              {"type": "null"}
            ]
          },
          "core_fit": {
            "type": "string",
            "enum": ["strong", "moderate", "weak", "none"]
          },
          "daily_work": {"type": "string", "minLength": 1, "maxLength": 600},
          "covered": {
            "type": "array",
            "maxItems": 30,
            "items": {"type": "string", "minLength": 1, "maxLength": 120}
          },
          "addable": {
            "type": "array",
            "maxItems": 15,
            "items": {"type": "string", "minLength": 1, "maxLength": 100}
          },
          "true_gap": {
            "type": "array",
            "maxItems": 30,
            "items": {"type": "string", "minLength": 1, "maxLength": 160}
          },
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 700}
        }
      }
    }
  }
}
