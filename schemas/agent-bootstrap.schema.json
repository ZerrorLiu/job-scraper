{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/job-scraper/agent-bootstrap.schema.json",
  "title": "Job Scraper Agent Bootstrap Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "label",
    "queries",
    "locations",
    "countries",
    "keywords",
    "sources"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "countries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "channels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "pipeline": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "sinks": {
      "type": "array",
      "uniqueItems": true,
      "default": [
        "csv"
      ],
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "email": {
      "type": "boolean",
      "default": false
    },
    "imap_host": {
      "type": "string",
      "default": ""
    },
    "timezone": {
      "type": "string",
      "default": "UTC"
    }
  }
}
