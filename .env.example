# Copy this file to .env once. Leave unused integrations blank.
# The default composition -- LinkedIn into a CSV file -- needs none of these.
JOB_SCRAPER_CONFIG_DIR=

# Bright Data (optional, paid). Credentials alone never submit a snapshot:
# each use also requires its own explicit flag below.
BRIGHTDATA_API_KEY=
BRIGHTDATA_DATASET_ID=
BRIGHTDATA_DIRECT_COLLECTION_ENABLED=false
BRIGHTDATA_EMAIL_DETAIL_ENRICHMENT_ENABLED=false

# Optional: when both are set, Indeed acquisition never blocks waiting on a
# Bright Data snapshot. It submits with `notify` pointed at this receiver and
# returns immediately; a later run picks up the result once the receiver
# reports it ready. Requires a receiver you host and can reach. Leave blank to
# keep the synchronous poll-until-ready behavior, which is the default.
BRIGHTDATA_WEBHOOK_URL=
BRIGHTDATA_WEBHOOK_TOKEN=

# Recommendation mailbox (optional). The password must be a provider-issued
# application password, not the account login password.
JOB_EMAIL_USERNAME=
JOB_EMAIL_APP_PASSWORD=

# Notion (optional). The token is an internal integration secret, and the
# integration must also be granted access to the destination page. Set one of
# NOTION_PARENT_PAGE_ID or NOTION_DATABASE_ID.
NOTION_INTEGRATION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_DATABASE_ID=
