# --- Private runtime workspace -------------------------------------------
# The complete runtime workspace is private. Agents create it locally from the
# public configuration reference; no profile, query, location, watchlist, or
# integration layout is committed.
/config/
.env
data/
exports/
logs/
output/
outputs/
tmp/
*.db-wal
*.db-shm

# --- Credentials ----------------------------------------------------------
session_credentials.json
synchronized_dataset.json
my_cookies.json
*cookies*.json

# --- Local-only material --------------------------------------------------
# Everything finished, superseded, or one-off lives under /local/, archived out
# of the package so it is not linted, type-checked, or counted as live code.
# See local/README.md. Only /docs/public/ is the current public contract, so
# any stray root-level docs Markdown is local by definition.
/local/
/docs/*.md
.vibe/archive/

# Personal career strategy output and analysis derived from private job data.
/career-strategy-analysis/
/job-market-analysis/
/最终求职结论.md

# --- Tooling and build artifacts (regenerable; delete, never archive) ------
.venv/
.venv*/
.agents/
.codex/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store
Thumbs.db
