# Copy to /etc/positions/positions-web.env with mode 0600. Use private paths.
POSITIONS_PORTAL_DB=/srv/positions-private/portal/portal.db
POSITIONS_UPLOAD_ROOT=/srv/positions-private/portal/uploads
POSITIONS_PUBLIC_URL=https://positions.example
POSITIONS_CANDIDATE_WORKSPACE=/srv/positions-private/candidate-workspace
POSITIONS_CODEX_HOMES=/srv/positions-private/codex-primary:/srv/positions-private/codex-secondary

# Store real SMTP values only in /etc/positions/positions-web.env, never Git.
POSITIONS_SMTP_HOST=smtp.example
POSITIONS_SMTP_PORT=587
POSITIONS_SMTP_FROM=positions@example.test
POSITIONS_SMTP_USERNAME=fictional-user
POSITIONS_SMTP_PASSWORD=replace-in-private-file
