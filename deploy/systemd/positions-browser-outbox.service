[Unit]
Description=Apply accepted Positions browser results
After=network-online.target positions-browser-api.service

[Service]
Type=oneshot
User=dev
Group=dev
WorkingDirectory=/srv/positions
Environment=HOME=/home/dev
Environment=PATH=/home/dev/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/dev/.local/bin/uv run job-scraper browser outbox run --limit 100
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/srv/positions /home/dev
UMask=0027
